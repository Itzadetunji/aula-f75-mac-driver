{
  "name": "f75-studio",
  "version": "0.1.0",
  "description": "macOS configurator for the AULA F75 keyboard",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build:helper": "cd native/f75-helper && swift build -c release",
    "dev": "bun run build:helper && electron-vite dev",
    "build": "bun run build:helper && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "electron scripts/make-icon.mjs",
    "package": "bun run icon && bun run build && electron-builder --mac --dir",
    "dist": "bun run icon && bun run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "dev.local.f75studio",
    "productName": "AULA F75 Mac Driver",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "native/f75-helper/.build/release/f75-helper",
        "to": "f75-helper"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.5",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.17",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
